# ── Store ─────────────────────────────────────────────────────────────────
# The nearmerch you point at. x402 is OFF on https://nearmerch.com for now, so default to a
# local dev server running the x402 intents integration (X402_ENABLED=true,
# X402_INTENTS_ENABLED=true, PING_API_KEY set on the store side).
NEARMERCH_URL=http://localhost:3000

# Ping host, used only for public discovery in `npm run check` (no key needed).
PING_URL=https://pay.pingpay.io

# ── Agent Connect (payer wallet, MCP) ─────────────────────────────────────
# Dashboard → Connect your agent → API key (Bearer, 30 days). Never commit it.
AGENT_CONNECT_KEY=
AGENT_CONNECT_MCP_URL=https://agent-connect-app-production.up.railway.app/mcp
# Exact account name from get_accounts (empty = first enabled account).
AGENT_CONNECT_ACCOUNT=
# Intents asset withdrawn to Base (default: native USDC on NEAR).
NEAR_USDC_WITHDRAW_TOKEN=

# Base (EVM) address you control. Sent as `refundTo` on the quote: Ping refunds an
# underpaid/failed deposit and unused slippage buffer here. No fallback.
REFUND_ADDRESS=

# ── Sign in with NEAR (nearmerch checkout needs a session) ────────────────
# key           → NEAR_ACCOUNT_ID + NEAR_PRIVATE_KEY (full-access key, ed25519:...) signs NEP-413 locally
# agent-connect → the agent's own NEAR key via MCP near_sign_message (owner must allow
#                 native.near.sign_message for recipient near-merch-store.near) — experimental
NEARMERCH_SIGNER=key
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# ── What to buy ───────────────────────────────────────────────────────────
# Explicit ids win; else first title containing PRODUCT_QUERY; else the cheapest ungated item.
PRODUCT_ID=
VARIANT_ID=
PRODUCT_QUERY=
QUANTITY=1

# Shipping address (required for quote + checkout; the order is fulfilled for real once paid).
SHIP_FIRST_NAME=
SHIP_LAST_NAME=
SHIP_EMAIL=
SHIP_LINE1=
SHIP_LINE2=
SHIP_CITY=
SHIP_STATE=
SHIP_POSTCODE=
SHIP_COUNTRY=
SHIP_PHONE=

# ── Safety ────────────────────────────────────────────────────────────────
# Refuse any quote, order or withdraw above this many USDC.
MAX_USDC=40
# withdraw_preview calls per payment for the gross-up (each counts toward the custody quota).
MAX_PREVIEWS=3
